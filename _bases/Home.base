filters:
  and:
    - file.ext == "md"
properties:
  file.fullname:
    displayName: Full File Name
  file.name:
    displayName: File Name
  note.title:
    displayName: Title
  note.date:
    displayName: Date
  note.target_level:
    displayName: Target
  note.origin:
    displayName: Origin
  note.roaster:
    displayName: Roaster
  note.green_weight_g:
    displayName: Green (g)
  note.roasted_weight_g:
    displayName: Roasted (g)
  note.time_to_fc:
    displayName: FC
  note.total_time:
    displayName: Total
  note.rating:
    displayName: Rating
  note.tags:
    displayName: Tags
  note.draft:
    displayName: Draft
views:
  - type: cms
    name: Roasts
    filters:
      and:
        - file.folder.startsWith("src/content/roasts")
    sort:
      - property: note.date
        direction: DESC
    imageFormat: none
    showDate: true
    customizeNewButton: true
    newNoteLocation: src/content/roasts
    fallbackToEmbeds: if-empty
    propertyDisplay1: file.fullname
    showTextPreview: true
    propertyLabels: above
    titleProperty: note.title
    dateProperty: note.date
    descriptionProperty: note.origin
    showTags: true
    tagsProperty: note.tags
    showDraftStatus: true
    draftStatusUseFilenamePrefix: false
    draftStatusProperty: note.draft
  - type: cms
    name: Vault CMS Guide
    filters:
      and:
        - file.folder == "/"
        - file.name.endsWith("GUIDE")
    order: []
    sort:
      - property: file.ctime
        direction: DESC
    fallbackToEmbeds: never
    propertyDisplay1: file.fullname
    showTextPreview: true
    imageFormat: none
    showDate: false
    showDraftStatus: false
    propertyLabels: above
    titleProperty: note.title
    propertyLayout12SideBySide: false
    propertyLayout34SideBySide: false
    showTags: false
    customizeNewButton: false
    newNoteLocation: ""
    cardSize: 250
    imageAspectRatio: 0.55
    maxTagsToShow: 2
    dateIncludeTime: false
    descriptionProperty: note.description
    hideQuickEditIcon: true
