---
import type { Phase } from "../lib/roastStats";
interface Props {
  phases: Phase[];
}
const { phases } = Astro.props;

// Phase fill colors — drawn from the roast-level scale + the accent (data key).
const COLOR: Record<Phase["name"], string> = {
  Drying: "var(--level-light)",
  Maillard: "var(--level-medium)",
  Development: "var(--accent)",
};

// Target ticks: cumulative drying% and drying%+maillard% (50 and 80 for 50/30/20).
const t0 = phases[0]?.target ?? 0;
const t1 = t0 + (phases[1]?.target ?? 0);

const deltaText = (p: Phase) => {
  const d = Math.round((p.pct - p.target) * 10) / 10;
  return d === 0 ? "on target" : `${d > 0 ? "+" : ""}${d} pt vs target`;
};
const label = phases.map((p) => `${p.name} ${p.pct}%`).join(", ");
---

<section class="phases">
  <div class="phases-head">
    <span class="section-label">Phase split vs 50 / 30 / 20</span>
    <span class="phases-hint metric">your roast</span>
  </div>

  <div class="bar" role="img" aria-label={`Roast phases: ${label}`}>
    <div class="track">
      {phases.map((p) => (
        <div class="seg" style={`width:${p.pct}%;background:${COLOR[p.name]}`} />
      ))}
    </div>
    <span class="tick" style={`left:${t0}%`}></span>
    <span class="tick" style={`left:${t1}%`}></span>
  </div>

  <div class="legend">
    {
      phases.map((p) => (
        <div class="leg">
          <div class="leg-name">
            <span class="leg-swatch" style={`background:${COLOR[p.name]}`} />
            {p.name}
          </div>
          <div class="leg-val metric">{p.mmss} · {p.pct}%</div>
          <div class="leg-delta metric">{deltaText(p)}</div>
        </div>
      ))
    }
  </div>
</section>

<style>
  .phases {
    margin-top: 26px;
  }
  .phases-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 12px;
  }
  .phases-hint {
    font-size: 10.5px;
    color: var(--dim);
  }

  .bar {
    position: relative;
    height: 30px;
  }
  .track {
    display: flex;
    height: 100%;
    border-radius: 5px;
    overflow: hidden;
    background: var(--surface-2);
  }
  .seg {
    min-width: 0;
  }
  .tick {
    position: absolute;
    top: -3px;
    height: 36px;
    width: 1.5px;
    background: var(--text);
    opacity: 0.55;
    transform: translateX(-0.75px);
  }

  .legend {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
    margin-top: 12px;
  }
  .leg-name {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    color: var(--text);
  }
  .leg-swatch {
    width: 9px;
    height: 9px;
    border-radius: 2px;
    flex: 0 0 auto;
  }
  .leg-val {
    font-size: 11.5px;
    color: var(--muted);
    margin-top: 5px;
  }
  .leg-delta {
    font-size: 10px;
    color: var(--dim);
    margin-top: 2px;
  }

  @media (max-width: 560px) {
    .legend {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
