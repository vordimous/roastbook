---
// Bean-temp curve drawn from the button-log readings. Only renders when the
// interventions log is a clean one-reading-per-line list of °F numbers (roast
// 015's "pure-manual" format). Logs in other formats yield no curve.
interface Props {
  /** The raw `interventions` frontmatter string. */
  log?: string | null;
  /** Elapsed time to first crack (mm:ss), shown on the FC marker caption. */
  fcTime?: string | null;
}
const { log, fcTime } = Astro.props;

// A line counts as a temperature only if the WHOLE line is a number — so button
// presses ("D", "P3") and "mm:ss — pressed" lines are skipped, not misparsed.
const temps = (log ?? "")
  .split(/\r?\n/)
  .map((s) => s.trim())
  .filter((s) => /^\d+(?:\.\d+)?$/.test(s))
  .map(Number);

const W = 340,
  H = 96,
  pad = 8;
const peak = temps.length ? Math.max(...temps) : 0;
const mn = temps.length ? Math.min(...temps) - 5 : 0;
const mx = peak + 4;
const span = mx - mn || 1;

const x = (i: number) => pad + (i / (temps.length - 1)) * (W - 2 * pad);
const y = (v: number) => pad + (1 - (v - mn) / span) * (H - 2 * pad);

const points = temps.map((v, i) => `${x(i).toFixed(1)},${y(v).toFixed(1)}`).join(" ");
const area = `${pad},${H - pad} ${points} ${W - pad},${H - pad}`;
const peakIdx = temps.indexOf(peak);
const charge = temps[0];
const drop = temps[temps.length - 1];
const show = temps.length >= 2;
---

{
  show && (
    <div class="curve">
      <div class="curve-head">
        <span class="section-label">Bean temp — button log</span>
        <span class="curve-hint metric">°F / 30s</span>
      </div>
      <svg
        viewBox={`0 0 ${W} ${H}`}
        width="100%"
        height="130"
        preserveAspectRatio="none"
        class="curve-svg"
      >
        <polyline points={area} fill="var(--accent)" fill-opacity="0.08" stroke="none" />
        <polyline
          points={points}
          fill="none"
          stroke="var(--accent)"
          stroke-width="1.6"
          stroke-linejoin="round"
          stroke-linecap="round"
        />
        <circle
          cx={x(peakIdx).toFixed(1)}
          cy={y(peak).toFixed(1)}
          r="3"
          fill="var(--ink)"
          stroke="var(--accent)"
          stroke-width="1.6"
        />
      </svg>
      <div class="curve-caption metric">
        <span>charge {charge}°F</span>
        <span class="fc">● FC ~{peak}°F{fcTime ? ` @ ${fcTime}` : ""}</span>
        <span>drop {drop}°F</span>
      </div>
    </div>
  )
}

<style>
  .curve {
    margin-top: 26px;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    padding: 18px 20px;
  }
  .curve-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 14px;
  }
  .curve-hint {
    font-size: 10.5px;
    color: var(--dim);
  }
  .curve-svg {
    display: block;
    overflow: visible;
  }
  .curve-caption {
    display: flex;
    justify-content: space-between;
    font-size: 9.5px;
    color: var(--dim);
    margin-top: 8px;
  }
  .curve-caption .fc {
    color: var(--muted);
  }
</style>
