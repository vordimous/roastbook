---
import type { RoastStats } from "../lib/roastStats";
interface Props {
  stats: RoastStats;
}
const { stats } = Astro.props;
const dash = "—";

const cells = [
  { label: "FC", value: stats.fc ?? dash },
  { label: "Total", value: stats.total ?? dash },
  { label: "Dev", value: stats.dev ?? dash },
  { label: "DTR", value: stats.dtrPct != null ? `${stats.dtrPct}%` : dash },
  { label: "Loss", value: stats.lossPct != null ? `${stats.lossPct}%` : dash },
];

// Left-side label for the ready strip, per rest-window status.
const READY_LABEL: Record<string, string> = {
  resting: "Resting — almost ready",
  ready: "Ready to drink",
  "past-peak": "Past peak",
};
const readyLabel = stats.ready ? READY_LABEL[stats.ready.status] : "";
---

<div class="readout">
  {
    cells.map((c) => (
      <div class="cell">
        <div class="cell-label">{c.label}</div>
        <div class="cell-value">{c.value}</div>
      </div>
    ))
  }
</div>

{
  stats.ready && (
    <div class="ready-strip">
      <div class="ready-left">
        <span class={`dot-status ${stats.ready.status}`} />
        <span class="ready-text">
          {readyLabel}
          <span class="ready-detail"> · {stats.ready.detail}</span>
        </span>
      </div>
      <div class="ready-window metric">{stats.ready.text}</div>
    </div>
  )
}

<style>
  /* 5-up instrument readout: hairline-separated tiles over a line-soft bg. */
  .readout {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 1px;
    background: var(--line-soft);
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    overflow: hidden;
    margin-top: 22px;
  }
  .cell {
    background: var(--surface-2);
    padding: 16px 14px;
  }
  .cell-label {
    font-family: var(--font-mono);
    font-size: 9.5px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--dim);
  }
  .cell-value {
    font-family: var(--font-mono);
    font-size: 22px;
    font-weight: 500;
    color: var(--text);
    margin-top: 5px;
  }

  .ready-strip {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
    padding: 13px 16px;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
  }
  .ready-left {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .ready-text {
    font-size: 13px;
    color: var(--muted);
  }
  .ready-detail {
    color: var(--dim);
  }
  .ready-window {
    font-size: 13px;
    color: var(--accent);
    white-space: nowrap;
  }

  @media (max-width: 560px) {
    .readout {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
