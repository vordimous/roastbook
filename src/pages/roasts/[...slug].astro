---
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const roasts = await getCollection("roasts");
  return roasts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{d.title}</title>
    <style>
      :root {
        color-scheme: light dark;
      }
      body {
        font: 16px/1.5 -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
        max-width: 760px;
        margin: 2rem auto;
        padding: 0 1.25rem;
      }
      h1 {
        margin-bottom: 0.25rem;
      }
      .meta {
        color: #888;
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
      }
      dl.frontmatter {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.25rem 1rem;
        background: rgba(127, 127, 127, 0.08);
        padding: 0.75rem 1rem;
        border-radius: 6px;
        margin-bottom: 2rem;
        font-size: 0.9rem;
      }
      dl.frontmatter dt {
        font-weight: 600;
        color: #666;
      }
      dl.frontmatter dd {
        margin: 0;
      }
      table {
        border-collapse: collapse;
        margin: 1rem 0;
      }
      th,
      td {
        border: 1px solid rgba(127, 127, 127, 0.3);
        padding: 0.4rem 0.7rem;
        text-align: left;
      }
      pre {
        background: rgba(127, 127, 127, 0.08);
        padding: 0.75rem 1rem;
        border-radius: 6px;
        overflow-x: auto;
      }
      a.back {
        display: inline-block;
        margin-bottom: 1rem;
      }
    </style>
  </head>
  <body>
    <a class="back" href="/">← all roasts</a>
    <h1>{d.title}</h1>
    <p class="meta">
      {d.date.toISOString().slice(0, 10)} · {d.target_level} · {d.roaster}
    </p>

    <dl class="frontmatter">
      {d.origin && <><dt>Origin</dt><dd>{d.origin}</dd></>}
      {d.process && <><dt>Process</dt><dd>{d.process}</dd></>}
      {d.vendor && <><dt>Vendor</dt><dd>{d.vendor}</dd></>}
      {d.profile && <><dt>Profile</dt><dd>{d.profile}</dd></>}
      {d.weight_setting && <><dt>Weight</dt><dd>{d.weight_setting}</dd></>}
      {d.batch_size_g && <><dt>Batch (g)</dt><dd>{d.batch_size_g}</dd></>}
      {d.green_weight_g && <><dt>Green (g)</dt><dd>{d.green_weight_g}</dd></>}
      {d.roasted_weight_g && <><dt>Roasted (g)</dt><dd>{d.roasted_weight_g}</dd></>}
      {d.ambient_f != null && <><dt>Ambient</dt><dd>{d.ambient_f}°F · {d.ambient_rh}% RH</dd></>}
      {d.time_to_fc && <><dt>FC at</dt><dd>{d.time_to_fc}</dd></>}
      {d.total_time && <><dt>Total</dt><dd>{d.total_time}</dd></>}
      {d.color_at_fc && <><dt>Color @ FC</dt><dd>{d.color_at_fc}</dd></>}
      {d.smell_at_fc && <><dt>Smell @ FC</dt><dd>{d.smell_at_fc}</dd></>}
      {d.why_dropped && <><dt>Dropped on</dt><dd>{d.why_dropped}</dd></>}
      {d.rating != null && <><dt>Rating</dt><dd>{d.rating}/10</dd></>}
    </dl>

    <Content />
  </body>
</html>
