---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import { marked } from "marked";
import Base from "../../layouts/Base.astro";
import RoastHeadline from "../../components/RoastHeadline.astro";
import PhaseBar from "../../components/PhaseBar.astro";
import TempCurve from "../../components/TempCurve.astro";
import { computeRoastStats } from "../../lib/roastStats";
import { parseRoastTitle, levelColor } from "../../lib/roastDisplay";
import { withBase, withBaseHtml } from "../../lib/url";

export async function getStaticPaths() {
  // Build draft detail pages in dev for preview, but not in prod.
  const roasts = (await getCollection("roasts")).filter(
    (entry) => !import.meta.env.PROD || !entry.data.draft,
  );
  return roasts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const stats = computeRoastStats(d);
const parsed = parseRoastTitle(d.title);

// "in range" / "under by X%" / "over by X%" label for a computed value.
const round1 = (n: number) => Math.round(Math.abs(n) * 10) / 10;
function badgeText(
  badge: "ok" | "under" | "over" | undefined,
  val: number | null,
  range?: [number, number],
): string | null {
  if (!badge || val == null || !range) return null;
  if (badge === "ok") return "in range";
  return badge === "under" ? `under ${round1(range[0] - val)}%` : `over ${round1(val - range[1])}%`;
}
const lossBadgeText = badgeText(stats.lossBadge, stats.lossPct, stats.targetLevel?.loss_pct);
const dtrBadgeText = badgeText(stats.dtrBadge, stats.dtrPct, stats.targetLevel?.dtr_pct);

// Render a long-form markdown frontmatter field to HTML (Hugo's `markdownify`).
// Root-relative links authored in the notes ("/roasts/...") are rewritten to the
// deploy base so they survive a project-site sub-path.
const md = (s?: string | null) =>
  s ? withBaseHtml(marked.parse(s) as string) : "";

// --- Roast plan rows ------------------------------------------------------
const conditions =
  d.ambient_f != null || d.ambient_rh != null
    ? [d.ambient_f != null ? `${d.ambient_f}°F` : null, d.ambient_rh != null ? `${d.ambient_rh}% RH` : null]
        .filter(Boolean)
        .join(" / ")
    : null;

const planRows: { k: string; v: string }[] = [
  d.origin && { k: "Origin", v: d.origin },
  d.process && { k: "Process", v: d.process },
  { k: "Target", v: d.target_level },
  { k: "Roaster", v: d.roaster },
  d.profile && { k: "Profile", v: d.profile },
  d.batch_size_g && { k: "Batch", v: `${d.batch_size_g} g` },
  d.green_weight_g && { k: "Green weight", v: `${d.green_weight_g} g` },
  conditions && { k: "Conditions", v: conditions },
].filter(Boolean) as { k: string; v: string }[];

// --- Target rows (from the level table) -----------------------------------
const t = stats.targetLevel;
const targetRows = t
  ? [
      { k: "Weight loss", v: `${t.loss_pct[0]}–${t.loss_pct[1]}%` },
      { k: "DTR", v: `${t.dtr_pct[0]}–${t.dtr_pct[1]}%` },
      { k: "Drop", v: t.drop },
      { k: "Flavor", v: t.flavor },
    ]
  : [];

// --- Measured rows (with delta chips) -------------------------------------
const measuredRows = [
  d.roasted_weight_g && { k: "Roasted", v: `${d.roasted_weight_g} g`, delta: null },
  stats.lossPct != null && { k: "Weight loss", v: `${stats.lossPct}%`, delta: lossBadgeText },
  stats.dev && { k: "Dev time", v: stats.dev, delta: null },
  stats.dtrPct != null && { k: "DTR", v: `${stats.dtrPct}%`, delta: dtrBadgeText },
].filter(Boolean) as { k: string; v: string; delta: string | null }[];

// --- Timing + live-note rows ----------------------------------------------
const timingRows = [
  d.time_to_dry_end && { k: "Dry end", v: d.time_to_dry_end },
  d.time_to_fc && { k: "First crack", v: d.time_to_fc },
  d.total_time && { k: "Drop", v: d.total_time },
].filter(Boolean) as { k: string; v: string }[];

const noteRows = [
  d.color_at_fc && { k: "Color at FC", v: d.color_at_fc },
  d.smell_at_fc && { k: "Smell at FC", v: d.smell_at_fc },
  d.why_dropped && { k: "Why dropped", v: d.why_dropped },
].filter(Boolean) as { k: string; v: string }[];

// --- Long-form prose sections ---------------------------------------------
const sections = [
  d.bean_notes && { label: "Bean-specific notes", html: md(d.bean_notes) },
  d.playbook && { label: "Today's playbook", html: md(d.playbook) },
  d.anything_weird && { label: "Anything weird", html: md(d.anything_weird) },
  d.tasting_notes && { label: "Tasting notes", html: md(d.tasting_notes) },
  d.next_time && { label: "What to change next time", html: md(d.next_time) },
].filter(Boolean) as { label: string; html: string }[];
---

<Base title={d.title}>
  <a class="back metric" href={withBase("/")}>← all roasts</a>

  <div class="detail-header">
    <div class="detail-header-main">
      <h1 class="detail-title">
        {parsed.num && <span class="num">{parsed.num} — </span>}{parsed.name}
        {parsed.qualifier && <span class="qual">({parsed.qualifier})</span>}
      </h1>

      <div class="meta metric">
        <span>{d.date.toISOString().slice(0, 10)}</span>
        <span class="sep">·</span>
        <span class="meta-level">
          <span class="swatch" style={`background:${levelColor(d.target_level)}`} />
          {d.target_level}
        </span>
        <span class="sep">·</span>
        <span>{d.roaster}</span>
      </div>
    </div>

    {
      d.roasted_photo && (
        <figure class="specimen">
          <Image
            class="specimen-img"
            src={d.roasted_photo}
            width={296}
            height={296}
            alt={`Cooled, roasted beans for ${d.title}`}
            loading="eager"
          />
          <figcaption class="specimen-cap metric">
            Specimen{parsed.num ? ` · ${parsed.num}` : ""}
          </figcaption>
        </figure>
      )
    }
  </div>

  {stats.hasMeasurements && <RoastHeadline stats={stats} />}

  <div class="two-col">
    <div>
      <div class="section-label">Roast plan</div>
      <div class="kv">
        {planRows.map((r) => (
          <div class="kv-row">
            <span class="kv-k">{r.k}</span>
            <span class="kv-v">{r.v}</span>
          </div>
        ))}
      </div>
    </div>

    {
      (targetRows.length > 0 || measuredRows.length > 0) && (
        <div>
          {targetRows.length > 0 && (
            <>
              <div class="section-label">Targets — {d.target_level}</div>
              <div class="kv">
                {targetRows.map((r) => (
                  <div class="kv-row">
                    <span class="kv-k">{r.k}</span>
                    <span class="kv-v metric">{r.v}</span>
                  </div>
                ))}
              </div>
            </>
          )}
          {measuredRows.length > 0 && (
            <>
              <div class="section-label measured-label">Measured</div>
              <div class="kv">
                {measuredRows.map((r) => (
                  <div class="kv-row">
                    <span class="kv-k">{r.k}</span>
                    <span class="kv-measured">
                      <span class="kv-v metric">{r.v}</span>
                      {r.delta && <span class="delta metric">{r.delta}</span>}
                    </span>
                  </div>
                ))}
              </div>
            </>
          )}
        </div>
      )
    }
  </div>

  {stats.phases && <PhaseBar phases={stats.phases} />}

  <TempCurve log={d.interventions} fcTime={d.time_to_fc} />

  {
    (timingRows.length > 0 || noteRows.length > 0) && (
      <div class="two-col timing-notes">
        {timingRows.length > 0 && (
          <div>
            <div class="section-label">Timing</div>
            <div class="kv">
              {timingRows.map((r) => (
                <div class="kv-row">
                  <span class="kv-k muted">{r.k}</span>
                  <span class="kv-v metric">{r.v}</span>
                </div>
              ))}
            </div>
          </div>
        )}
        {noteRows.length > 0 && (
          <div>
            <div class="section-label">Live notes</div>
            <div class="kv">
              {noteRows.map((r) => (
                <div class="kv-row">
                  <span class="kv-k">{r.k}</span>
                  <span class="kv-v note-v">{r.v}</span>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    )
  }

  {
    d.interventions && (
      <section class="block">
        <div class="section-label">Button log — every press</div>
        <pre class="button-log">{d.interventions}</pre>
      </section>
    )
  }

  {
    sections.map((s) => (
      <section class="block">
        <div class="section-label">{s.label}</div>
        <div class="prose" set:html={s.html} />
      </section>
    ))
  }

  {
    entry.body?.trim() && (
      <section class="block">
        <div class="prose"><Content /></div>
      </section>
    )
  }
</Base>

<style>
  .back {
    display: inline-block;
    font-size: 11px;
    color: var(--accent);
    margin-bottom: 14px;
  }
  .detail-header {
    display: flex;
    align-items: flex-start;
    gap: 20px;
  }
  .detail-header-main {
    flex: 1;
    min-width: 0;
  }
  .specimen {
    flex: 0 0 auto;
    margin: 0;
    text-align: center;
  }
  .specimen-img {
    width: 148px;
    height: 148px;
    object-fit: cover;
    border-radius: 6px;
    border: 1px solid var(--line);
    display: block;
  }
  .specimen-cap {
    font-size: 9px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--dim);
    margin-top: 6px;
  }
  .detail-title {
    font-family: var(--font-serif);
    font-size: 27px;
    font-weight: 600;
    line-height: 1.12;
    margin: 0;
  }
  .detail-title .num {
    color: var(--text);
  }
  .detail-title .qual {
    color: var(--muted);
    font-weight: 500;
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 10px;
    font-size: 12px;
    color: var(--muted);
  }
  .meta .sep {
    color: var(--sep);
  }
  .meta-level {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .meta-level .swatch {
    width: 11px;
    height: 11px;
    border-radius: 2px;
  }

  /* Two-column data sections */
  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 26px;
    margin-top: 26px;
  }
  .timing-notes {
    grid-template-columns: 1.1fr 1fr;
  }

  .measured-label {
    display: block;
    margin-top: 18px;
  }
  .kv {
    margin-top: 12px;
  }
  .kv-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 14px;
    padding: 8px 0;
    border-bottom: 1px solid var(--hair);
  }
  .kv-k {
    font-size: 12.5px;
    color: var(--dim);
    flex: 0 0 auto;
  }
  .kv-k.muted {
    color: var(--muted);
  }
  .kv-v {
    font-size: 12.5px;
    color: var(--text);
    text-align: right;
  }
  .note-v {
    text-align: right;
  }
  .kv-measured {
    display: flex;
    align-items: baseline;
    gap: 8px;
  }
  .kv-measured .kv-v {
    font-size: 13px;
  }
  .delta {
    font-size: 10px;
    color: var(--accent);
    white-space: nowrap;
  }

  /* Long-form blocks */
  .block {
    margin-top: 26px;
    padding-top: 20px;
    border-top: 1px solid var(--line-soft);
  }
  .block .prose {
    margin-top: 10px;
  }
  .button-log {
    margin: 10px 0 0;
    padding: 12px 14px;
    background: var(--surface-2);
    border: 1px solid var(--line-soft);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--muted);
    white-space: pre-wrap;
    overflow-x: auto;
  }

  @media (max-width: 560px) {
    .two-col,
    .timing-notes {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .detail-header {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 14px;
    }
  }
</style>
