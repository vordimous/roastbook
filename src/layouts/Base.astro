---
interface Props {
  title?: string;
  frontmatter?: { title?: string };
}
// Used directly (title prop) and as an MDX page layout (frontmatter.title).
const { title, frontmatter } = Astro.props;
const pageTitle = title ?? frontmatter?.title ?? "roastbook";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --border: rgba(127, 127, 127, 0.3);
    --bg-alt: rgba(127, 127, 127, 0.06);
    --muted: #888;
  }
  body {
    font: 16px/1.6 -apple-system, BlinkMacSystemFont, system-ui, sans-serif;
    max-width: 820px;
    margin: 2rem auto;
    padding: 0 1.25rem;
  }
  a {
    color: #3b82f6;
  }
  h1 {
    margin-bottom: 0.25rem;
  }
  table {
    border-collapse: collapse;
    margin: 1rem 0;
  }
  th,
  td {
    border: 1px solid var(--border);
    padding: 0.4rem 0.7rem;
    text-align: left;
  }
  pre {
    background: var(--bg-alt);
    padding: 0.75rem 1rem;
    border-radius: 6px;
    overflow-x: auto;
  }
  /* Reference tables on the guide pages (methods / machine). */
  table.roast-ref {
    width: 100%;
    font-size: 0.9rem;
  }
  table.roast-ref th {
    background: var(--bg-alt);
    font-weight: 600;
  }
  table.roast-ref code {
    font-size: 0.85em;
  }
</style>
