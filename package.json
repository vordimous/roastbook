{
  "name": "roastbook-spike",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@9.6.0",
  "description": "Throwaway Phase-0 spike: validate astro-editor multi-line/image/enum rendering against the intended roastbook Zod schema.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro check && pnpm sveltia:emit && pnpm sveltia:test && git diff --exit-code public/admin/config.yml",
    "sveltia:emit": "tsx --import ./scripts/register-astro-stubs.mjs scripts/emit-sveltia-config.ts",
    "sveltia:test": "tsx --import ./scripts/register-astro-stubs.mjs --test scripts/emit-sveltia-config.test.ts"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "astro": "^7.0.2",
    "marked": "^18.0.5",
    "sharp": "^0.35.2",
    "zod": "4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^26.0.1",
    "tsx": "^4.22.4",
    "typescript": "^5.6.3",
    "yaml": "^2.9.0"
  }
}
